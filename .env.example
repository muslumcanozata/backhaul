# shared: bir pod, birden fazla firma. dedicated: bir pod, tek firma.
DEPLOYMENT_MODE=shared

# Supabase Postgres (Transaction pooler veya doğrudan bağlantı).
# Örnek: postgresql+psycopg://postgres.[ref]:[şifre]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Yerel (Supabase kapalı) oturum imzası. Supabase açıkken kullanılmaz.
JWT_SECRET=

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# dedicated icin zorunlu. shared podda bos birakilir.
TENANT_ID=

# Firma sirlarini sifreleyen anahtar. Bir firmanin Netgsm sifresi degildir.
SECRETS_KEY=

# Supabase (proje: https://ipmejpxeywneeaabvqmj.supabase.co).
# SUPABASE_URL doluysa Auth + Realtime + Postgres zorunlu; yerelde bos birak.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Yalnizca dedicated pod. Bu degerler TENANT_ID firmasina aittir.
# shared podda dolu olursa surec acilmaz.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
ARVENTO_USERNAME=
ARVENTO_PIN1=
ARVENTO_PIN2=
SEYIR_USERNAME=
SEYIR_PASSWORD=

# Kurulumun harita anahtarlari. Firma takip hesabi degildir.
# Tarayici anahtari apps/web/.env icinde VITE_GOOGLE_MAPS_BROWSER_KEY olur.
# Uretimde API ayni origin (nginx). Ayri host icin VITE_API_URL=http://ip:8000.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Routes rota matrisi gunluk tavan. 0 kapatir. Ustune operator onayi gerekir.
ROUTES_DAILY_LIMIT=333
# Seyir/Arvento otomatik cekim araligi (saniye). 0 kapatir.
TELEMATICS_POLL_SECONDS=30
